// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id               Int       @id @default(autoincrement())
  content          String
  isImportant      Boolean   @default(false)
  isUrgent         Boolean   @default(false)
  quadrant         String    @default("INBOX") // INBOX, DO, SCHEDULE, DELEGATE, ELIMINATE
  status           String    @default("TODO") // TODO, DONE
  estimatedMinutes Int?
  actualMinutes    Int?
  dueDate          DateTime?
  delegateId       Int?
  delegate         Delegate? @relation(fields: [delegateId], references: [id], onDelete: SetNull)
  workspaceId      Int       @default(1)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags             String? // Comma-separated tags
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?
  isDeleted        Boolean   @default(false)
  reminderMinutesBefore Int?
  isNotified       Boolean   @default(false)

  @@index([quadrant])
  @@index([status])
  @@index([dueDate])
  @@index([workspaceId])
}

model Delegate {
  id          Int       @id @default(autoincrement())
  name        String
  email       String?
  tasks       Task[]
  workspaceId Int       @default(1)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, workspaceId])
  @@index([workspaceId])
}

model Workspace {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  color       String     @default("indigo")
  icon        String?    @default("Briefcase")
  dailyNotificationTime String? @default("09:00")
  tasks       Task[]
  delegates   Delegate[]
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, userId])
}



model User {
  id        Int         @id @default(autoincrement())
  username  String      @unique
  password  String
  isAdmin   Boolean     @default(false)
  status    String      @default("APPROVED") // PENDING, APPROVED
  tokenVersion Int      @default(0)
  workspaces Workspace[]
  activeWorkspaceId  Int?
  maxDailyMinutes    Int         @default(480)
  analyticsStartDate DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  chatUsage     UserChatUsage?
  quotaRequests ChatQuotaRequest[]
}

// Global AI chat quota settings (single row, managed by admin)
model ChatQuotaSettings {
  id           Int      @id @default(autoincrement())
  period       String   @default("DAY")  // "DAY" | "WEEK"
  defaultLimit Int      @default(20)     // messages allowed per period
  updatedAt    DateTime @updatedAt
}

// Per-user chat usage counters — reset automatically based on period
model UserChatUsage {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedToday     Int      @default(0)
  usedThisWeek  Int      @default(0)
  extraQuota    Int      @default(0)     // admin-approved bonus messages (does not reset)
  lastResetDate DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// User-raised requests for additional chat quota
model ChatQuotaRequest {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedExtra Int                       // number of extra messages requested
  reason         String?                   // optional justification from user
  status         String    @default("PENDING") // PENDING | APPROVED | PARTIALLY_APPROVED | REJECTED
  approvedAmount Int?                      // set by admin on approval
  adminNote      String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([userId])
  @@index([status])
}
