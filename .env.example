# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-very-strong-jwt-secret-here"

# ── AI Chat — At least one LLM provider key is required ───────────────────────
# Keys are ONLY used server-side and never exposed to the client.

# Gemini 1.5 Flash (Google AI Studio — free tier available)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI GPT-4o-mini (free trial credits available)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude Haiku (free tier available)
# https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ── Notes ─────────────────────────────────────────────────────────────────────
# - Provider priority: Gemini → OpenAI → Claude
# - The chatbot auto-falls back to the next configured provider on rate limits (429)
# - Multiple providers can be configured simultaneously for resilience
# - In deployment (CI/CD), inject these as secret environment variables
